{
  "name": "eslint-plugin-antd-a11y",
  "version": "0.10.0",
  "description": "ESLint rules and config for accessibility issues in Ant Design apps; the same checks the antd A11y Guard GitHub Action runs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "antd",
    "ant-design",
    "a11y",
    "accessibility",
    "wcag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cstayyab/antd-a11y-action.git",
    "directory": "packages/eslint-plugin-antd-a11y"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.1",
    "eslint-plugin-jsx-a11y": "^6.10.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
